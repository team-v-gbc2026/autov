        return sqrt(dot(p - float2(0.25f, 0.75f), p - float2(0.25f, 0.75f))) - 0.3535533845424652099609375f;
    }
    float2 a = p - float2(0.0f, 1.0f);
    float2 b = p - (0.5f * max(p.x + p.y, 0.0f)).xx;
    return sqrt(min(dot(a, a), dot(b, b))) * sign(p.x - p.y);
}

