# Set to your app subdomain after attaching both domains to the Vercel project.
# Leave unset to use /workspace locally and on preview deployments.
# NEXT_PUBLIC_APP_URL=https://app.example.com

# Supabase project settings → API. Only the publishable key belongs in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://tkjstnitmfwgmedipcvs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local VFX generation. These values must NEVER use a NEXT_PUBLIC_ prefix.
# Save the key in frontend/.env.local or use http://127.0.0.1:3000/local/settings.
OPENAI_API_KEY=
# Verified model/rate pair used by the cumulative $30 local spending guard.
OPENAI_VFX_MODEL=gpt-6-astra
# dev:local sets AUTOV_LOCAL_MODE=1 so /workspace opens the local studio.
# Set AUTOV_LOCAL_DISABLED=1 to disable the local API entirely.
