# Set to your app subdomain after attaching both domains to the Vercel project.
# Leave unset to use /workspace locally and on preview deployments.
# NEXT_PUBLIC_APP_URL=https://app.example.com

# Supabase project settings → API. Only the publishable key belongs in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://tkjstnitmfwgmedipcvs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only agent credentials. Never prefix these with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
VFX_AGENT_MODEL=openai/gpt-5.6-luna-fast

# VFX v2 assets live in two PUBLIC Supabase Storage buckets, not in the build:
#   vfx-textures/v2/<file>             the 32-texture library + manifest.json
#   vfx-fixtures/v2/<id>/document.json the seven exemplar documents
# Leave this unset to derive it from NEXT_PUBLIC_SUPABASE_URL:
#   <NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/vfx-textures/v2
# Set it to serve the texture library from somewhere else (mirror, CDN, or a
# local path such as /textures/v2 when you keep the PNGs in public/).
# NEXT_PUBLIC_VFX_ASSET_BASE=https://tkjstnitmfwgmedipcvs.supabase.co/storage/v1/object/public/vfx-textures/v2

# Upload the assets with `npm run upload:vfx-assets`. Secret API key (sb_secret_...) only —
# never NEXT_PUBLIC_, never committed; keep it in frontend/.env.local.
SUPABASE_SECRET_KEY=

# Local VFX generation. These values must NEVER use a NEXT_PUBLIC_ prefix.
# Save the key in frontend/.env.local or use http://127.0.0.1:3000/dev/vfx-lab/settings.
OPENAI_API_KEY=
# Verified model/rate pair used by the cumulative $30 local spending guard.
OPENAI_VFX_MODEL=gpt-6-astra
# dev:local sets AUTOV_LOCAL_MODE=1, which enables local reference clips.
# The local studio lives at /dev/vfx-lab and exists only in `next dev`.
# Set AUTOV_LOCAL_DISABLED=1 to disable the local API entirely.

# Eve studio tools are always enabled. Apply the studio_tools migration.
# Requires SUPABASE_SECRET_KEY and OPENAI_API_KEY above, server-side only.
# Cumulative generation budget per project (positive, at most 80 USD).
OPENAI_VFX_BUDGET_USD=30
