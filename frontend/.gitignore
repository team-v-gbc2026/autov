# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local generation secrets, evidence, cumulative spend ledger
.autov-local/
test-results/
playwright-report/
public/vfx-runtime.js
public/vfx-runtime.js.LICENSE.txt
public/vfx-runtime-v2.js
public/vfx-runtime-v2.js.LICENSE.txt

# dev-only routes, linked in from dev-pages/ for local dev only —
# never present in a production build
/src/app/(dev)/

# Splat backdrop assets — large binaries (tens of MB each), kept local.
# The viewer's Backdrop panel also accepts a URL or a local file, so nothing
# here is required to use the feature.
/public/backdrops/*.ply
/public/backdrops/*.spz
/public/backdrops/*.ksplat
/public/backdrops/*.splat
