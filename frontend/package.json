{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "eve build && next build && node scripts/verify-dev-excluded.mjs",
    "start": "next start",
    "lint": "eslint",
    "dev:local": "AUTOV_LOCAL_MODE=1 next dev --hostname 127.0.0.1 --port 3000",
    "test": "tsx --test tests/*.test.ts tests/agent/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "predev:local": "npm run bundle:runtime",
    "prebuild": "npm run bundle:runtime",
    "verify:runtime": "node scripts/verify-renderer.mjs",
    "benchmark": "node scripts/run-benchmark.mjs",
    "verify:browser": "node scripts/verify-vfx-browser.mjs",
    "upload:vfx-assets": "node scripts/upload-vfx-assets.mjs",
    "generate:v2-nodes": "node --import tsx scripts/webgpu/port-shaders.mts",
    "verify:webgpu": "node scripts/webgpu/verify-port.mjs",
    "verify:studio": "node scripts/webgpu/verify-studio.mjs",
    "build:agent": "eve build",
    "test:agent": "node --import tsx --test tests/agent/*.test.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-draggable": "^4.7.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "sharp": "0.35.4",
    "three": "0.186.0",
    "zod": "^4.6.2",
    "ai": "7.0.99",
    "eve": "0.54.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
